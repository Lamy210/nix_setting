# nix_setting tasks — run: just <recipe>

default:
    @just --list

# ---- nix_setting 本体 ----
apply:
    @echo "applying..."
    nh switch .#macbook-air

apply-linux:
    @echo "applying linux..."
    nh home switch .#linux

build:
    @echo "building..."
    nix build .#homeConfigurations.macbook-air.activationPackage

check:
    @echo "checking..."
    nix flake check --allow-import-from-derivation

fmt:
    @echo "formatting..."
    nix fmt

update:
    @echo "updating flake..."
    nix flake update

clean:
    @echo "cleaning..."
    nix-store --gc

# ---- lint / test ----
lint:
    @echo "linting..."
    statix check .
    deadnix --fail .
    shellcheck bootstrap.sh bench-shell.sh

test:
    @echo "testing..."
    bats tests/bootstrap.bats

bench:
    @echo "benchmarking..."
    ./bench-shell.sh

# ---- docker ----
docker-up:
    docker compose up -d

docker-down:
    docker compose down

docker-check:
    docker compose run check

# ---- db ----
db-pg:
    pgcli postgres://localhost:5432/db

db-mysql:
    mycli -h localhost -u root

# ---- k8s ----
k8s-apply:
    kubectl apply -f .

k8s-logs:
    kubectl logs -f deployment/app
